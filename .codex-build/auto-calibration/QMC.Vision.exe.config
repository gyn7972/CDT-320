<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- 바텀 검사 병렬화가 코어 전체를 쓰며 소형 객체를 대량 할당 — 서버 GC(코어별 힙)로 GC 정지 최소화(2026-07-12).
         워크스테이션 GC 에서는 131MP 검사 중 GC 정지가 스캔 병렬 구간을 수백 ms 지연시키는 것을 확인했다. -->
    <gcServer enabled="true" />
    <gcConcurrent enabled="true" />
  </runtime>
</configuration>
